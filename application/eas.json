{
  "cli": {
    "version": ">= 15.0.12",
    "appVersionSource": "remote",
    "requireCommit": true
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "release",
        "EXPO_PUBLIC_API_URL": "https://api.left30.app"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "apk",
        "withoutCredentials": true
      },
      "env": {
        "NODE_ENV": "production",
        "APP_VARIANT": "release",
        "EXPO_PUBLIC_API_URL": "https://api.left30.app"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
