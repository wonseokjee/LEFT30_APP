# 복사해서 .env(운영·개발) 또는 .env.test(e2e)로 쓴다. 실제 값은 git에 올리지 않는다.
PORT=3030
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=left30
# 배포(Neon): 이 값이 있으면 위 DB_* 대신 쓰고 SSL로 접속한다.
# 앱(Vercel)은 pooled 주소(-pooler), 마이그레이션은 direct 주소를 쓴다.
# DATABASE_URL=
# access와 refresh는 서로 다른 긴 임의 문자열
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# 카카오 개발자 콘솔 > 앱 설정 > 앱 ID(숫자). 이 앱에 발급된 토큰만 로그인에 받는다. 없으면 서버가 시작하지 않는다.
KAKAO_APP_ID=
